---
import { getCollection } from 'astro:content';
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const allLessons = await getCollection('lessons');
  const m0Lessons = allLessons.filter((l) => l.data.module === 'm0');
  return m0Lessons.map((lesson) => ({
    params: { lesson: `l${lesson.data.number}` },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const base = import.meta.env.BASE_URL;
const isWip = lesson.data.status === 'wip';
const d = lesson.data;

const typeLabels = {
  intro: "Вступний",
  main: "Концептуальний",
  practical: "Практика",
  review: "Підсумковий",
  case: "Кейс",
};

// Розбити терміни по роздільнику ·
const newTermsList = d.newTerms ? d.newTerms.split('·').map(t => t.trim()).filter(Boolean) : [];
---

<BaseLayout
  title={`Урок ${d.number}. ${d.title}`}
  description={d.keyQuestion}
>

  {/* HERO УРОКУ — ПОВНА ШИРИНА, ТЕМНО-ЗЕЛЕНИЙ */}
  <section class="bg-forest text-paper">
    <div class="max-w-4xl mx-auto px-6 pt-12 pb-16 md:pt-16 md:pb-20">

      {/* Хлібні крихти */}
      <nav aria-label="Breadcrumbs" class="mb-10">
        <ol class="flex flex-wrap items-center gap-x-2 font-sans text-sm text-paper/70">
          <li><a href={`${base}course/`} class="hover:text-paper underline underline-offset-4 decoration-paper/30">Курс</a></li>
          <li class="text-paper/40">/</li>
          <li><a href={`${base}course/m0/`} class="hover:text-paper underline underline-offset-4 decoration-paper/30">Модуль 0</a></li>
          <li class="text-paper/40">/</li>
          <li class="text-paper/90">Урок {d.number}</li>
        </ol>
      </nav>

      {/* Цифра + мітка */}
      <div class="flex items-baseline gap-6 mb-8">
        <p class="font-mono text-6xl md:text-7xl text-paper leading-none font-light">
          {String(d.number).padStart(2, '0')}
        </p>
        <div>
          <p class="kicker text-paper/70 mb-1">{typeLabels[d.lessonType]}</p>
          <p class="font-sans text-sm text-paper/60">{d.time} хвилин{isWip ? ' · у розробці' : ''}</p>
        </div>
      </div>

      {/* Заголовок уроку */}
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-paper leading-[1.1] mb-10 max-w-3xl">
        {d.title}
      </h1>

      {/* Ключове запитання — в hero, не окремою врізкою */}
      <div class="border-t border-paper/20 pt-8 max-w-3xl">
        <p class="kicker text-paper/70 mb-3">Ключове запитання</p>
        <p class="font-display text-xl md:text-2xl text-paper italic font-light leading-snug">
          {d.keyQuestion}
        </p>
      </div>

    </div>
  </section>

  {/* ВЕЛИКА ІДЕЯ */}
  {d.bigIdea && (
    <section class="max-w-4xl mx-auto px-6 py-16 md:py-20">
      <div class="border-l-[3px] border-signal pl-8 max-w-3xl">
        <p class="kicker mb-4 text-signal">Велика ідея</p>
        <p class="font-display text-2xl md:text-3xl text-ink leading-[1.25]">
          {d.bigIdea}
        </p>
      </div>
    </section>
  )}

  {/* СТАРТОВИЙ ГАЧОК */}
  {d.hook && (
    <section class="max-w-4xl mx-auto px-6 pb-16 md:pb-20">
      <div class="bg-paper-warm">
        <div class="h-1 bg-ochre"></div>
        <div class="px-8 py-10 md:px-12 md:py-12">
          <p class="kicker mb-5">Стартовий гачок</p>
          <p class="font-body text-lg text-ink leading-relaxed whitespace-pre-line">
            {d.hook}
          </p>
        </div>
      </div>
    </section>
  )}

  {/* ОСНОВНИЙ МАТЕРІАЛ */}
  {d.mainContent && (
    <section class="max-w-4xl mx-auto px-6 pb-16 md:pb-20">
      <div class="max-w-2xl">
        <p class="kicker mb-5">Основний матеріал</p>
        <div class="font-body text-lg text-ink leading-[1.75] whitespace-pre-line">
          {d.mainContent}
        </div>
      </div>
    </section>
  )}

  {/* ТЕРМІНИ */}
  {(newTermsList.length > 0 || d.returningTerms) && (
    <section class="max-w-4xl mx-auto px-6 pb-16 md:pb-20">
      <div class="bg-forest-pale px-8 py-10 md:px-12 md:py-12">

        {newTermsList.length > 0 && (
          <div class="mb-8">
            <p class="kicker mb-5 text-forest-deep">Нові терміни</p>
            <ul class="flex flex-wrap gap-3">
              {newTermsList.map((term) => (
                <li class="font-sans text-sm font-medium text-forest-deep border border-forest/30 px-4 py-2 bg-paper">
                  {term}
                </li>
              ))}
            </ul>
          </div>
        )}

        {d.returningTerms && (
          <div class="border-t border-forest/20 pt-6">
            <p class="kicker mb-3 text-forest-deep">Повертаємось до</p>
            <p class="font-body text-base text-ink-soft leading-relaxed">
              {d.returningTerms}
            </p>
          </div>
        )}

      </div>
    </section>
  )}

  {/* ============================================================== */}
  {/* НИЖЧЕ — СТАРІ СЕКЦІЇ. ЦЕ ТИМЧАСОВО, ПЕРЕРОБЛЯТИМЕМО НАСТУПНИМ ПРОМПТОМ. */}
  {/* ============================================================== */}

  <section class="max-w-2xl mx-auto px-6 pb-24">

    {/* ВІЗУАЛІЗАЦІЯ */}
    {d.visualization && (
      <section class="mb-12">
        <p class="meta mb-3">Інфографіка</p>
        <p class="font-body text-base text-ink-soft leading-relaxed italic">
          {d.visualization}
        </p>
      </section>
    )}

    {/* ПРАКТИЧНЕ ЗАВДАННЯ */}
    {d.task && (
      <section class="bg-paper-deep px-8 py-8 mb-12 -mx-2 md:mx-0">
        <p class="meta mb-3">Практичне завдання</p>
        <p class="font-body text-base text-ink leading-relaxed whitespace-pre-line">
          {d.task}
        </p>
      </section>
    )}

    {/* CER-РАМКА */}
    {d.cerFrame && (
      <section class="bg-sage-pale px-8 py-8 mb-12 -mx-2 md:mx-0">
        <p class="meta mb-3">CER-рамка</p>
        <p class="font-body text-base text-ink leading-relaxed italic">
          {d.cerFrame}
        </p>
      </section>
    )}

    {/* ГУМАНІТАРНІ МОСТИ */}
    {d.humanitiesBridges && (
      <section class="mb-12">
        <p class="meta mb-4">Гуманітарні мости</p>
        <div class="grid md:grid-cols-2 gap-6">
          {d.humanitiesBridges.law && (
            <div class="border-l-2 border-rule pl-4">
              <p class="font-mono text-xs text-forest mb-2 uppercase tracking-wider">Право</p>
              <p class="font-body text-base text-ink-soft leading-relaxed">{d.humanitiesBridges.law}</p>
            </div>
          )}
          {d.humanitiesBridges.relationships && (
            <div class="border-l-2 border-rule pl-4">
              <p class="font-mono text-xs text-forest mb-2 uppercase tracking-wider">Стосунки</p>
              <p class="font-body text-base text-ink-soft leading-relaxed">{d.humanitiesBridges.relationships}</p>
            </div>
          )}
          {d.humanitiesBridges.psychology && (
            <div class="border-l-2 border-rule pl-4">
              <p class="font-mono text-xs text-forest mb-2 uppercase tracking-wider">Психологія</p>
              <p class="font-body text-base text-ink-soft leading-relaxed">{d.humanitiesBridges.psychology}</p>
            </div>
          )}
          {d.humanitiesBridges.society && (
            <div class="border-l-2 border-rule pl-4">
              <p class="font-mono text-xs text-forest mb-2 uppercase tracking-wider">Суспільство</p>
              <p class="font-body text-base text-ink-soft leading-relaxed">{d.humanitiesBridges.society}</p>
            </div>
          )}
        </div>
      </section>
    )}

    {/* ЦИТАТА */}
    {d.quote && (
      <section class="bg-forest-pale px-8 py-12 mb-12 -mx-2 md:mx-0">
        <blockquote class="font-display text-xl md:text-2xl text-ink leading-snug italic font-light">
          {d.quote}
        </blockquote>
      </section>
    )}

    {/* FUN FACT + ПРОФЕСІЯ */}
    {(d.funFact || d.profession) && (
      <section class="mb-12 grid md:grid-cols-2 gap-6">
        {d.funFact && (
          <div class="border-l-2 border-rule pl-4">
            <p class="font-mono text-xs text-forest mb-2 uppercase tracking-wider">Цікаво</p>
            <p class="font-body text-base text-ink-soft leading-relaxed">{d.funFact}</p>
          </div>
        )}
        {d.profession && (
          <div class="border-l-2 border-rule pl-4">
            <p class="font-mono text-xs text-forest mb-2 uppercase tracking-wider">Професія</p>
            <p class="font-body text-base text-ink-soft leading-relaxed">{d.profession}</p>
          </div>
        )}
      </section>
    )}

    {/* ЦИФРОВІ РЕСУРСИ */}
    {d.digitalResources && (d.digitalResources.video || d.digitalResources.interactive || d.digitalResources.tool) && (
      <section class="mb-12">
        <p class="meta mb-4">Цифрові ресурси</p>
        <ul class="space-y-3">
          {d.digitalResources.video && (
            <li class="border-l-2 border-forest pl-4">
              <p class="font-mono text-xs text-forest mb-1 uppercase tracking-wider">Відео</p>
              <p class="font-body text-base text-ink leading-relaxed">{d.digitalResources.video}</p>
            </li>
          )}
          {d.digitalResources.interactive && (
            <li class="border-l-2 border-forest pl-4">
              <p class="font-mono text-xs text-forest mb-1 uppercase tracking-wider">Інтерактив</p>
              <p class="font-body text-base text-ink leading-relaxed">{d.digitalResources.interactive}</p>
            </li>
          )}
          {d.digitalResources.tool && (
            <li class="border-l-2 border-forest pl-4">
              <p class="font-mono text-xs text-forest mb-1 uppercase tracking-wider">Інструмент</p>
              <p class="font-body text-base text-ink leading-relaxed">{d.digitalResources.tool}</p>
            </li>
          )}
        </ul>
      </section>
    )}

    {/* ДОМАШНЄ ЗАВДАННЯ */}
    {d.homework && (
      <section class="mb-12 border-t border-rule pt-8">
        <p class="meta mb-3">Домашнє завдання</p>
        <p class="font-body text-base text-ink leading-relaxed whitespace-pre-line">
          {d.homework}
        </p>
      </section>
    )}

    {/* ОЦІНЮВАННЯ */}
    {d.assessment && (
      <section class="mb-12">
        <p class="meta mb-3">Оцінювання</p>
        <p class="font-body text-base text-ink-soft leading-relaxed italic">
          {d.assessment}
        </p>
      </section>
    )}

    {/* ЗАГЛУШКА ДЛЯ WIP БЕЗ КОНТЕНТУ */}
    {isWip && !d.bigIdea && !d.hook && !d.mainContent && (
      <div class="border-l-2 border-rule pl-6 py-2 mb-12">
        <p class="font-body text-base text-ink-soft leading-relaxed mb-4">
          Цей урок ще в розробці. Структура — як описана в розділі <a href={`${base}about/`} class="text-forest hover:text-forest-deep border-b border-forest pb-0.5">«Як працювати з курсом»</a>.
        </p>
        <p class="font-body text-base text-ink-soft leading-relaxed">
          Поки що можеш повернутися до <a href={`${base}course/m0/`} class="text-forest hover:text-forest-deep border-b border-forest pb-0.5">переліку уроків Модуля 0</a>.
        </p>
      </div>
    )}

    {/* НАВІГАЦІЯ */}
    <nav class="flex justify-between items-center border-t border-rule pt-8 mt-12" aria-label="Навігація між уроками">
      {d.number > 1 ? (
        <a href={`${base}course/m0/l${d.number - 1}/`} class="font-body text-sm text-ink-soft hover:text-forest">
          ← Урок {d.number - 1}
        </a>
      ) : <span></span>}

      {d.number < 6 ? (
        <a href={`${base}course/m0/l${d.number + 1}/`} class="font-body text-sm text-ink-soft hover:text-forest">
          Урок {d.number + 1} →
        </a>
      ) : <span></span>}
    </nav>

  </section>

</BaseLayout>
