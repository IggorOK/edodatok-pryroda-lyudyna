---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FlaskConical, ClipboardList, Search, Headphones, BookOpen } from '@lucide/astro';

const base = import.meta.env.BASE_URL;

const modules = [
  {
    id: "m0",
    label: "Модуль 0",
    title: "Вступ: природа, людина і хімія як спосіб розуміння світу",
    meta: "6 уроків · 1–2 тижні",
    summary: "Як відрізнити науку від міфу. Чому одним твердженням варто довіряти, а іншим — ні. З чого починається будь-яке наукове знання.",
    href: `${base}course/m0/`,
    status: "available",
    barClass: "bg-forest",
  },
  {
    id: "m1",
    label: "Модуль 1",
    title: "Хімія природних систем: рівноваги, цикли, межі",
    meta: "24 уроки · 12–14 тижнів",
    summary: "Чому вода в одній річці прозора, а в іншій — каламутна. Як ліс, океан і атмосфера обмінюються речовинами. Де та межа, після якої природна система ламається.",
    href: `${base}course/`,
    status: "available",
    barClass: "bg-signal",
  },
  {
    id: "m2",
    label: "Модуль 2",
    title: "Атмосфера, повітря, клімат",
    meta: "у розробці",
    summary: null,
    href: null,
    status: "wip",
    barClass: "bg-rule",
  },
];

const libraries = [
  {
    label: "Інтерактивна лабораторія",
    summary: "Можна побачити, як змінюється pH, коли додаєш кислоту. Або що буває, коли в озері забагато добрив. Те, чого не зробити на папері.",
    href: `${base}library/lab/`,
    icon: FlaskConical,
  },
  {
    label: "Практичні роботи",
    summary: "Інструкції до робіт із простими матеріалами: індикатор із червонокачанної капусти, перевірка буферності води і молока. Відео, бланки, шаблон висновків.",
    href: `${base}library/practical/`,
    icon: ClipboardList,
  },
  {
    label: "Кейси",
    summary: "Реальні історії, у яких треба розібратись: чому в Фінті отруїлися люди, як Семмельвейс зрозумів причину смертності породіль, що сталося в Калуші.",
    href: `${base}library/cases/`,
    icon: Search,
  },
  {
    label: "Медіатека",
    summary: "14 подкастів і 18 відео: як працює природа, чому одні відкриття змінили життя, ким працюють хіміки і екологи поза лабораторією.",
    href: `${base}library/media/`,
    icon: Headphones,
  },
  {
    label: "Глосарій",
    summary: "Усі терміни курсу з простими поясненнями. У текстах уроків підсвічуються — наводиш курсор і одразу бачиш визначення.",
    href: `${base}library/glossary/`,
    icon: BookOpen,
  },
];

const tomeTwo = [
  { label: "М2", title: "Атмосфера, повітря, клімат" },
  { label: "М3", title: "Ґрунт, рослини, токсичність" },
  { label: "М4", title: "Зелена хімія. Річний проєкт" },
];
---

<BaseLayout title="Природа і людина. Цифрова лабораторія">

  {/* HERO — НАСИЧЕНИЙ ЗЕЛЕНИЙ БЛОК З ГЕОМЕТРИЧНОЮ КОМПОЗИЦІЄЮ */}
  <section class="bg-forest text-paper">
    <div class="max-w-6xl mx-auto px-6 pt-12 pb-16 md:pt-20 md:pb-24 grid md:grid-cols-2 gap-10 md:gap-16 items-center">

      {/* Текстова колонка */}
      <div>
        <p class="kicker text-paper/80 mb-6">Курс хімії, екології та сталого розвитку · 10–11 клас</p>

        <h1 class="font-display text-5xl md:text-6xl text-paper leading-[1.05] mb-8">
          Природа <span class="italic font-light text-paper/85">&amp;</span> Людина
          <span class="block font-display italic text-2xl md:text-3xl text-paper/75 font-light mt-3">
            цифрова лабораторія
          </span>
        </h1>

        <p class="font-sans text-lg md:text-xl text-paper/90 leading-relaxed mb-10 max-w-md">
          Як хімія, екологія і сталий розвиток допомагають зрозуміти світ навколо: воду в крані, повітря в місті, новини про клімат. Курс для тих, хто обрав гуманітарний шлях.
        </p>

        <div class="flex flex-wrap items-center gap-5">
          <a href={`${base}course/`} class="inline-flex items-center px-6 py-3 bg-paper text-ink font-sans font-semibold text-base hover:bg-paper-warm transition-colors">
            Почати курс
          </a>
          <a href={`${base}parents/`} class="font-sans text-sm text-paper/80 hover:text-paper underline underline-offset-4">
            Батькам
          </a>
        </div>
      </div>

      {/* Геометрична композиція замість зображення */}
      <div class="hidden md:block aspect-[4/5] relative">
        <div class="absolute inset-0 bg-forest-deep"></div>
        <div class="absolute top-0 right-0 w-3/5 h-3/5 bg-signal"></div>
        <div class="absolute bottom-0 left-0 w-2/3 h-2/3 bg-paper-warm"></div>
        <div class="absolute top-1/3 left-1/3 w-1/3 h-1/3 bg-forest border-4 border-paper"></div>
        <div class="absolute bottom-8 right-8">
          <p class="kicker text-paper/60">Том I · 30 уроків</p>
        </div>
      </div>

    </div>
  </section>

  {/* ТОМ I — МОДУЛІ КУРСУ */}
  <section class="max-w-6xl mx-auto px-6 py-20 md:py-24">

    <div class="flex items-baseline justify-between mb-12 border-b border-rule pb-6">
      <div>
        <p class="kicker mb-2">01 / Том I · 10 клас</p>
        <h2 class="font-display text-4xl md:text-5xl text-ink">
          Модулі курсу
        </h2>
      </div>
      <p class="hidden md:block font-sans text-sm text-ink-soft max-w-xs text-right">
        Три модулі, тридцять уроків. Перший — про науковий метод. Другий — про природні системи. Третій — про атмосферу й клімат.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {modules.map((m) => (
        m.status === "available" ? (
          <a href={m.href} class="block group bg-paper-warm hover:bg-paper-deep transition-colors">
            <div class={`h-2 ${m.barClass}`}></div>
            <div class="p-7">
              <p class="kicker mb-4">{m.label} · {m.meta}</p>
              <h3 class="font-sans text-2xl font-bold text-ink leading-tight mb-4 group-hover:text-forest transition-colors">
                {m.title}
              </h3>
              <p class="font-body text-base text-ink-soft leading-relaxed">
                {m.summary}
              </p>
            </div>
          </a>
        ) : (
          <div class="block bg-paper-warm/50">
            <div class={`h-2 ${m.barClass}`}></div>
            <div class="p-7">
              <p class="kicker mb-4 text-ink-soft">{m.label} · {m.meta}</p>
              <h3 class="font-sans text-2xl font-bold text-ink-soft leading-tight">
                {m.title}
              </h3>
            </div>
          </div>
        )
      ))}
    </div>

  </section>

  {/* БІБЛІОТЕКИ КУРСУ */}
  <section class="bg-paper-warm">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-24">

      <div class="mb-12 border-b border-rule pb-6">
        <p class="kicker mb-2">02 / Інструменти</p>
        <h2 class="font-display text-4xl md:text-5xl text-ink">
          Бібліотеки курсу
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {libraries.map((lib, idx) => {
          const Icon = lib.icon;
          return (
            <a href={lib.href} class:list={[
              "block group bg-paper hover:bg-paper-deep transition-colors p-7",
              idx === 4 && "lg:col-start-2",
            ]}>
              <Icon size={36} stroke-width={1.5} class="text-forest mb-6" />
              <h3 class="font-sans text-xl font-bold text-ink leading-tight mb-3 group-hover:text-forest transition-colors">
                {lib.label}
              </h3>
              <p class="font-body text-base text-ink-soft leading-relaxed">
                {lib.summary}
              </p>
            </a>
          );
        })}
      </div>

    </div>
  </section>

  {/* ТОМ II — АНОНС */}
  <section class="bg-ink text-paper">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-24">

      <p class="kicker text-paper/70 mb-2">03 / Том II · 11 клас</p>
      <h2 class="font-display text-4xl md:text-5xl text-paper mb-12 max-w-3xl">
        Далі: <span class="italic font-light text-paper/80">атмосфера, ґрунт, зелена хімія</span>
      </h2>

      <ul class="grid gap-4 md:grid-cols-3 border-t border-paper/20 pt-8">
        {tomeTwo.map((t) => (
          <li>
            <p class="kicker text-paper/60 mb-2">{t.label}</p>
            <p class="font-sans text-lg font-semibold text-paper leading-snug">{t.title}</p>
          </li>
        ))}
      </ul>

      <p class="font-sans text-sm text-paper/60 mt-12 max-w-md">
        У розробці. Готується до випуску після завершення першого тому.
      </p>

    </div>
  </section>

</BaseLayout>
