---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const lessonStructure = [
  { num: "01", title: "Ключове запитання", text: "Те, до чого урок шукає відповідь. Записуєш на полях книжки." },
  { num: "02", title: "Стартовий феномен", text: "Щось, що ти бачиш, чуєш або робиш — і що поки не очевидно, як пояснити." },
  { num: "03", title: "Пояснення", text: "Коротке, без зайвих формул. Те, що дійсно потрібно, щоб зрозуміти феномен." },
  { num: "04", title: "Інфографіка та інтерактив", text: "Можеш покрутити, перевірити, побачити, як змінюються величини." },
  { num: "05", title: "Завдання", text: "Самоперевірка — швидко. Компетентнісне — на думку. CER — на аргумент." },
  { num: "06", title: "Хочу більше", text: "Якщо тема зачепила: історія науки, гуманітарний міст, професія, дискусія." },
  { num: "07", title: "Що здати вчителю", text: "Зрозуміло, що саме й у якому форматі. Без здогадок." },
];

const inBook = [
  "Записуєш спостереження рукою",
  "Малюєш схеми й структури",
  "Пишеш CER базового рівня",
  "Будуєш графік на сітці",
  "Робиш польовий журнал практичної",
  "Ведеш особистий словник",
];

const inApp = [
  "Дивишся відео й слухаєш подкасти",
  "Працюєш з інтерактивами і симуляціями",
  "Аналізуєш новину, етикетку, графік",
  "Фотографуєш явище або зразок",
  "Складаєш CER зі складними даними",
  "Зберігаєш відповіді й передаєш учителю",
];
---

<BaseLayout
  title="Як працювати з курсом"
  description="Як влаштовано курс «Природа і людина. Цифрова лабораторія»: книжка і додаток разом, структура уроку, що тут є."
>
  <section class="max-w-2xl mx-auto px-6 pt-20 pb-12">
    <p class="meta mb-8">Як працювати з курсом</p>
    <h1 class="font-display text-5xl md:text-6xl text-ink leading-[1.1] mb-8">
      Дві частини, <span class="italic text-forest font-light">одна робота</span>
    </h1>
    <p class="font-body text-xl text-ink-soft leading-relaxed">
      У тебе є книжка-посібник і цей додаток. Книжка — там, де ти пишеш рукою, спостерігаєш, замальовуєш. Додаток — там, де відео, симуляції, дані і те, чого папір не дає. Кожен елемент курсу осідає там, де він сильніший.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12">
    <div class="bg-forest-pale px-10 py-12 md:px-16 md:py-16">
      <blockquote class="font-display text-2xl md:text-3xl text-ink leading-[1.3] italic font-light max-w-2xl">
        Цей курс не зробить з тебе хіміка. Він допоможе розуміти, що відбувається у воді, повітрі, ґрунті, їжі — і чому це варто розуміти.
      </blockquote>
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-6 py-16">
    <div class="mb-3">
      <p class="font-mono text-3xl text-forest leading-none mb-2">01</p>
      <p class="meta">Будова уроку</p>
    </div>
    <h2 class="font-display text-4xl md:text-5xl text-ink mb-10">
      З чого складається урок
    </h2>
    <p class="font-body text-lg text-ink-soft leading-relaxed mb-10">
      Усі 30 уроків — за однією логікою. Знаючи її, ти будеш орієнтуватись у будь-якому уроці за пів хвилини.
    </p>
    <ol class="space-y-6">
      {lessonStructure.map((step) => (
        <li class="border-l-2 border-forest pl-6">
          <p class="font-mono text-xs text-forest mb-1 uppercase tracking-wider">{step.num}</p>
          <p class="font-display text-xl text-ink mb-1">{step.title}</p>
          <p class="font-body text-base text-ink-soft leading-relaxed">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <hr class="max-w-2xl mx-auto" />

  <section class="max-w-4xl mx-auto px-6 py-16">
    <div class="mb-3 max-w-2xl mx-auto">
      <p class="font-mono text-3xl text-forest leading-none mb-2">02</p>
      <p class="meta">Книжка і додаток</p>
    </div>
    <h2 class="font-display text-4xl md:text-5xl text-ink mb-10 max-w-2xl mx-auto">
      Що ти робиш де
    </h2>
    <p class="font-body text-lg text-ink-soft leading-relaxed mb-12 max-w-2xl mx-auto">
      Не «що зручніше» і не «що сучасніше». Розподіл — за тим, що краще працює для розуміння.
    </p>
    <div class="grid md:grid-cols-2 gap-10 md:gap-12 border-t border-rule pt-12">
      <div>
        <p class="font-mono text-sm text-forest mb-4 uppercase tracking-wider">У книжці</p>
        <ul class="space-y-3 font-body text-base text-ink leading-relaxed">
          {inBook.map((item) => (
            <li class="border-l-2 border-rule pl-4">{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-mono text-sm text-forest mb-4 uppercase tracking-wider">У додатку</p>
        <ul class="space-y-3 font-body text-base text-ink leading-relaxed">
          {inApp.map((item) => (
            <li class="border-l-2 border-forest pl-4">{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <hr class="max-w-2xl mx-auto" />

  <section class="max-w-2xl mx-auto px-6 py-16">
    <div class="mb-3">
      <p class="font-mono text-3xl text-forest leading-none mb-2">03</p>
      <p class="meta">Розділи додатка</p>
    </div>
    <h2 class="font-display text-4xl md:text-5xl text-ink mb-10">
      Що тут є
    </h2>
    <div class="space-y-6 font-body text-base text-ink leading-relaxed">
      <p>
        <a href={`${base}course/`} class="font-display text-xl text-ink hover:text-forest border-b border-rule pb-0.5">Курс</a>
        <span class="block mt-1 text-ink-soft">30 уроків Модулів 0 і 1. Кожен — за однією логікою, з трьома режимами: для тебе, «хочу більше», для вчителя.</span>
      </p>
      <p>
        <a href={`${base}library/lab/`} class="font-display text-xl text-ink hover:text-forest border-b border-rule pb-0.5">Інтерактивна лабораторія</a>
        <span class="block mt-1 text-ink-soft">Симулятори того, що в посібнику не покажеш: як змінюється pH, як працює буферність, де межі стійкості.</span>
      </p>
      <p>
        <a href={`${base}library/practical/`} class="font-display text-xl text-ink hover:text-forest border-b border-rule pb-0.5">Практичні роботи</a>
        <span class="block mt-1 text-ink-soft">Інструкції, відео і бланки для робіт із простими матеріалами вдома або в класі.</span>
      </p>
      <p>
        <a href={`${base}library/cases/`} class="font-display text-xl text-ink hover:text-forest border-b border-rule pb-0.5">Кейси</a>
        <span class="block mt-1 text-ink-soft">Реальні історії, у яких ти рухаєшся кроками: збираєш докази, формулюєш гіпотезу, перевіряєш.</span>
      </p>
      <p>
        <a href={`${base}library/media/`} class="font-display text-xl text-ink hover:text-forest border-b border-rule pb-0.5">Медіатека</a>
        <span class="block mt-1 text-ink-soft">14 подкастів і 18 відео. До кожного — текстова версія, якщо краще читати, ніж слухати.</span>
      </p>
      <p>
        <a href={`${base}library/glossary/`} class="font-display text-xl text-ink hover:text-forest border-b border-rule pb-0.5">Глосарій</a>
        <span class="block mt-1 text-ink-soft">Усі терміни курсу з простими поясненнями. У текстах уроків підсвічені — клікаєш і одразу бачиш визначення.</span>
      </p>
    </div>
  </section>

  <hr class="max-w-2xl mx-auto" />

  <section class="max-w-2xl mx-auto px-6 py-16 pb-24">
    <div class="mb-3">
      <p class="font-mono text-3xl text-forest leading-none mb-2">04</p>
      <p class="meta">Якщо щось не так</p>
    </div>
    <h2 class="font-display text-4xl md:text-5xl text-ink mb-8">
      Зламано, незрозуміло, відсутнє
    </h2>
    <p class="font-body text-lg text-ink-soft leading-relaxed mb-6">
      Якщо інтерактив не працює, відео не відкривається, або в тексті є помилка — напиши. Це справді допомагає.
    </p>
    <p class="font-body text-base text-ink leading-relaxed">
      Швидка форма зворотного зв'язку — на сторінці <a href={`${base}support/`} class="text-forest hover:text-forest-deep border-b border-forest pb-0.5">Підтримка</a>. На кожній сторінці уроку також буде маленьке посилання «Помилка / пропозиція» — з ним лист уже містить URL і номер версії, тобі не треба їх копіювати.
    </p>
  </section>
</BaseLayout>
