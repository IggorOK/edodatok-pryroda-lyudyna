---
// Базовий шаблон сторінки. Підключає шрифти, глобальні стилі, Header і Footer.
// Використання: <BaseLayout title="..." description="..."><slot/></BaseLayout>

import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

const {
  title = "Природа і людина. Цифрова лабораторія",
  description = "Електронний додаток до посібника з хімії, екології та сталого розвитку для 10–11 класів гуманітарного профілю.",
  bodyClass = "",
} = Astro.props;

const fullTitle = title === "Природа і людина. Цифрова лабораторія"
  ? title
  : `${title} — Природа і людина`;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,700;1,400&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>

  <body class={`bg-paper text-ink font-body antialiased ${bodyClass}`.trim()}>
    <a href="#main" class="skip-link">Перейти до основного вмісту</a>

    <Header />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
